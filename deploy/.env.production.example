# Copia este archivo a deploy/.env.production en el servidor. No lo subas a Git.
# Genera secretos con: openssl rand -base64 48
POSTGRES_USER=gestionfinanzas
POSTGRES_PASSWORD=REEMPLAZA_POR_UN_SECRETO_LARGO_Y_UNICO
POSTGRES_DB=gestionfinanzas
DATABASE_URL=postgresql://gestionfinanzas:REEMPLAZA_LA_CONTRASENA_CODIFICADA@db:5432/gestionfinanzas?schema=public

# Debe tener al menos 32 caracteres y no reutilizarse para nada más.
JWT_SECRET=REEMPLAZA_POR_OTRO_SECRETO_LARGO_Y_UNICO
APP_ORIGIN=https://finanzas.tu-dominio.com
APP_DOMAIN=finanzas.tu-dominio.com
# Códigos distintos de al menos 16 caracteres, separados por comas. Uno por invitado.
INVITE_CODES=REEMPLAZA_POR_CODIGO_LARGO_PARA_TU_HERMANO
RUN_LEGACY_ACCOUNT_MIGRATION=false

EODHD_API_KEY=
MARKET_DATA_MAX_SYMBOLS=8
MARKET_DATA_CACHE_SECONDS=3600
