# Configuración local. No subas tu .env real al repositorio.
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestionfinanzas?schema=public
JWT_SECRET=usa_un_secreto_local_largo_de_al_menos_32_caracteres
APP_ORIGIN=http://localhost:3000
INVITE_CODES=codigo-local-solo-para-desarrollo
# Actívalo únicamente para ejecutar una vez la migración heredada de cuentas.
RUN_LEGACY_ACCOUNT_MIGRATION=false

# Crea una cuenta gratuita de EODHD y pega aquí la clave.
# El plan Free Starter permite 20 consultas/día y datos diarios de cierre de hasta un año para uso personal.
EODHD_API_KEY=

# Con el plan gratuito, 8 cubre una cartera pequeña manteniendo consultas con caché.
MARKET_DATA_MAX_SYMBOLS=8

# Tiempo en segundos que se conserva un cierre antes de consultarlo de nuevo.
MARKET_DATA_CACHE_SECONDS=3600
