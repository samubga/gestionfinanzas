datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String           @id @default(uuid())
  email                String           @unique
  password             String
  name                 String?
  startingBalance      Float            @default(0)
  startingBalanceCaixa Float            @default(0)
  startingBalanceTrade Float            @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  categories           Category[]
  tags                 Tag[]
  expenses             Expense[]
  incomes              Income[]
  monthlySummaries     MonthlySummary[]
  savingGoals          SavingGoal[]
  forecasts            ExpenseForecast[]
  investments          Investment[]
  bankAccounts         BankAccount[]
  accounts             Account[]
  transfers            Transfer[]
}

model Bank {
  id        String    @id @default(uuid())
  name      String
  code      String?
  logoUrl   String?
  color     String    @default("#6366F1")
  isCustom  Boolean   @default(false)
  userId    String?
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, userId])
}

model Account {
  id              String       @id @default(uuid())
  name            String
  type            String       @default("CHECKING") // CHECKING, SAVINGS, CASH, INVESTMENT, CREDIT_CARD, CRYPTO, OTHER
  startingBalance Float        @default(0)
  currency        String       @default("EUR")
  color           String       @default("#6366F1")
  icon            String       @default("💳")
  bankId          String?
  bank            Bank?        @relation(fields: [bankId], references: [id], onDelete: SetNull)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]
  incomes         Income[]
  investments     Investment[]
  transfersFrom   Transfer[]   @relation("FromAccount")
  transfersTo     Transfer[]   @relation("ToAccount")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([name, userId])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#3B82F6") // Hex color code for customized UI
  type      String    @default("expense") // "expense" or "income"
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  incomes   Income[]
  forecasts ExpenseForecast[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, type, userId])
}

model Tag {
  id        String            @id @default(uuid())
  name      String
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  ExpenseTag[]
  forecasts ExpenseForecast[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([name, userId])
}

model Expense {
  id            String       @id @default(uuid())
  amount        Float
  date          DateTime
  description   String
  paymentMethod String?      // Tarjeta, Efectivo, Transferencia, etc.
  notes         String?
  bank          String?
  imported      Boolean      @default(false)
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags          ExpenseTag[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model ExpenseTag {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([expenseId, tagId])
}

model Income {
  id          String    @id @default(uuid())
  amount      Float
  date        DateTime
  description String
  notes       String?
  bank        String?
  imported    Boolean   @default(false)
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MonthlySummary {
  id           String   @id @default(uuid())
  year         Int
  month        Int      // 1-12
  totalIncome  Float    @default(0)
  totalExpense Float    @default(0)
  totalSavings Float    @default(0)
  savingGoal   Float    @default(0)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([year, month, userId])
}

model SavingGoal {
  id        String   @id @default(uuid())
  year      Int
  month     Int
  amount    Float
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, userId])
}

model ExpenseForecast {
  id          String    @id @default(uuid())
  amount      Float
  description String
  date        DateTime?
  month       Int
  year        Int
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tagId       String?
  tag         Tag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Investment {
  id              String    @id @default(uuid())
  type            String    // e.g., "Acción", "ETF", "Fondo", "Criptomoneda", "Derivado"
  name            String
  ticker          String?   // Símbolo de mercado, ej. AAPL o VWCE.DE
  isin            String?   // Identificador internacional del instrumento
  exchange        String?   // Bolsa o mercado principal, ej. XETRA o NASDAQ
  currency        String    @default("EUR")
  units           Float?    // Número de participaciones, acciones o unidades
  unitPrice       Float?    // Precio de compra por unidad, en la divisa del activo
  amount          Float     // Capital invertido
  buyFee          Float     @default(0) // Comisiones/Costos de compra
  bank            String    @default("Trade Republic") // CaixaBank, Trade Republic, Manual, etc.
  startDate       DateTime
  status          String    @default("active") // "active" (invertido) o "withdrawn" (retirado)
  withdrawnAmount Float?    // Capital recuperado al retirar
  sellFee         Float?    @default(0) // Comisiones/Costos de venta
  endDate         DateTime? // Fecha de retirada
  notes           String?
  accountId       String?
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    InvestmentTransaction[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model InvestmentTransaction {
  id           String     @id @default(uuid())
  type         String     // PURCHASE, SAVEBACK, BONUS_SHARES, CASH_REWARD, DIVIDEND, SALE, TAX, FEE, ADJUSTMENT
  date         DateTime
  amount       Float      // Importe bruto del movimiento en la divisa de la inversión
  units        Float?     // Participaciones afectadas, si aplica
  unitPrice    Float?     // Precio por participación, si aplica
  fee          Float      @default(0)
  tax          Float      @default(0)
  notes        String?
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([investmentId, date])
}

model BankAccount {
  id              String   @id @default(uuid())
  name            String
  startingBalance Float    @default(0)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([name, userId])
}

model Transfer {
  id             String   @id @default(uuid())
  amount         Float
  date           DateTime
  description    String
  notes          String?
  fromAccountId  String
  fromAccount    Account  @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId    String
  toAccount      Account  @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
